{
  "name": "quiz-solver",
  "version": "0.3.1",
  "description": "Desktop quiz assistant: capture a multiple-choice question from screen, embedded browser, or screenshot; a vision model reads it via OpenRouter and answers with confidence scoring.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage"
  },
  "build": {
    "publish": null,
    "appId": "com.quizsolver.app",
    "productName": "Quiz Solver",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "lib/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "QuizSolver-${version}-${arch}.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  },
  "author": "Wasd603"
}
